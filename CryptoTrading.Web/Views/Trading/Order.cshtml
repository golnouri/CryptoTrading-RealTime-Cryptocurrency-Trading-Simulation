@model CryptoTrading.Domain.Entities.Order

<h2>ثبت سفارش</h2>

<form asp-controller="Trading" asp-action="Order" method="post">

    <div>
        <label>نوع سفارش</label>

        <select asp-for="Type">
            <option value="1">خرید</option>
            <option value="2">فروش</option>
        </select>
    </div>

    <br />

    <div>
        <label>قیمت</label>

        <input asp-for="Price" type="number" />
    </div>

    <br />

    <div>
        <label>مقدار USDT</label>

        <input asp-for="Quantity" type="number" step="0.01" />
    </div>

    <br />

    <button type="submit">
        ثبت سفارش
    </button>

</form>